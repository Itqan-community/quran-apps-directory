# next-auth@5.0.0-beta.32 declares peerOptional nodemailer@"^7.0.7 || ^8.0.5",
# which conflicts with our direct nodemailer@^10 dependency. The app only uses
# next-auth's credentials provider, so its optional nodemailer integration is
# never loaded; skip strict peer resolution to keep npm commands working.
legacy-peer-deps=true
