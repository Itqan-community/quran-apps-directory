{
  "name": "quran-apps-next-js",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "drizzle-kit push --force",
    "db:push:test": "DATABASE_URL=postgres://postgres:postgres@localhost:5433/qad_test drizzle-kit push --force",
    "db:pgvector": "node --experimental-strip-types --env-file=.env.local db/enable-pgvector.ts",
    "db:migrate-live": "node --experimental-strip-types --env-file=.env.local db/migrate-live.ts",
    "db:seed": "node --experimental-strip-types --env-file=.env.local db/seed.ts",
    "db:sync-live-json": "node --experimental-strip-types --env-file=.env.local db/sync-live-json.ts",
    "embeddings:reindex": "node --experimental-strip-types --env-file=.env.local scripts/reindex-embeddings.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:parity": "node --experimental-strip-types --env-file=.env.local db/parity-check.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@sentry/nextjs": "^11.5.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.3",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.13",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "ua-parser-js": "^2.0.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
