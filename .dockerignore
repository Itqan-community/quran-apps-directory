node_modules
.next
.worktrees
.superpowers
.git
.github
.env*
!.env.example
# Certs written by the certbot container as root (mode 700). Unreadable by the
# build user, so leaving them in the context fails the build with
# "error from sender: open …/certbot/letsencrypt/accounts: permission denied".
certbot/letsencrypt
# Production DB dumps must never be baked into image layers.
*.dump
# Same for the generated prod-clone seed snapshot (contains submissions PII).
db/seed-data/prod-clone.json
e2e
docs
*.md
!package.json
!package-lock.json
