# Production environment for docker-compose.prod.yml — copy to .env.prod and
# fill in. .env.prod is git-ignored; never commit it.

# ── Stack wiring (nginx + certbot) ────────────────────────────────────────────
# The public domain nginx serves and certbot issues for (no scheme).
DOMAIN=apps.example.com
# Space-separated extras if needed (must already exist as DNS records):
ADDITIONAL_DOMAINS=
# Cloudflare API Token — Zone → DNS → Edit on the zone (NOT the Global Key).
CF_DNS_API_TOKEN=
# ACME account email (expiry notices from Let's Encrypt).
ACME_EMAIL=ops@example.com
# Set STAGING=1 for a first dry-run against the Let's Encrypt staging CA
# (no rate limits), then flip back to 0 and `down`/`up` once more.
STAGING=0

# ── App ───────────────────────────────────────────────────────────────────────
# Managed Postgres — MUST have the pgvector extension available.
DATABASE_URL=postgres://user:password@db-host:5432/qad
# Public origin (baked into metadata/OG/sitemap); also a build arg.
NEXT_PUBLIC_SITE_URL=https://apps.example.com

# Auth.js (generate: openssl rand -base64 32)
AUTH_SECRET=
AUTH_URL=https://apps.example.com
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Script access to /upload (autofill flows)
ADMIN_API_KEY=

# Cloudflare R2 (production bucket — real R2, no endpoint override)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
R2_ENDPOINT=
R2_FORCE_PATH_STYLE=

# Sentry (optional; NEXT_PUBLIC_SENTRY_DSN is also a build arg)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional, enables source-map upload during docker build:
# SENTRY_ORG= SENTRY_PROJECT= SENTRY_AUTH_TOKEN=

# View analytics IP hashing
VIEW_IP_SALT=

# Submission emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# AI smart search — leave AI_SEARCH_PROVIDER=mock if no key is wired yet;
# everything degrades to keyword fallback with a visible notice.
AI_SEARCH_PROVIDER=gemini # gemini | openai | mock
AI_API_KEY=
GEMINI_API_KEY=
AI_EMBEDDING_MODEL=models/gemini-embedding-001
AI_BASE_URL=
