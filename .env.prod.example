# Production environment for docker-compose.prod.yml — copy to .env.prod and
# fill in. .env.prod is git-ignored; never commit it.

# ── Stack wiring (nginx + certbot) ────────────────────────────────────────────
# The public domain certbot issues for (no scheme). nginx itself serves any
# Host (`server_name _`), so it does not need this value.
DOMAIN=apps.example.com
# Space-separated extras if needed (must already exist as DNS records):
ADDITIONAL_DOMAINS=
# Cloudflare API Token — Zone → DNS → Edit on the zone (NOT the Global Key).
# Empty/failed issuance is non-fatal: nginx keeps serving the first-boot
# self-signed pair and certbot retries every 12 h.
CF_DNS_API_TOKEN=
# ACME account email (expiry notices from Let's Encrypt).
ACME_EMAIL=ops@example.com
# Set STAGING=1 for a first dry-run against the Let's Encrypt staging CA
# (no rate limits), then flip back to 0 and `down`/`up` once more.
STAGING=0
# Host port mappings (defaults 80/443). Override when the machine's ports are
# taken — e.g. the local dry-run below uses 8080/8443.
# HTTP_PORT= HTTPS_PORT=

# ── App ───────────────────────────────────────────────────────────────────────
# Managed Postgres — MUST have the pgvector extension available.
DATABASE_URL=postgres://user:password@db-host:5432/qad
# Build-only DB URL for the prerender stage. Unset on the VPS (the managed DB
# is reachable there, so DATABASE_URL is used directly). Set it when building
# somewhere DATABASE_URL's host isn't reachable — the local dry-run needs it
# (see the block at the bottom).
# BUILD_DATABASE_URL=
# Public origin (baked into metadata/OG/sitemap); also a build arg.
NEXT_PUBLIC_SITE_URL=https://apps.example.com

# Auth.js (generate: openssl rand -base64 32)
AUTH_SECRET=
AUTH_URL=https://apps.example.com
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Script access to /upload (autofill flows)
ADMIN_API_KEY=

# Cloudflare R2 (production bucket — real R2, no endpoint override)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
R2_ENDPOINT=
R2_FORCE_PATH_STYLE=

# Sentry (optional; NEXT_PUBLIC_SENTRY_DSN is also a build arg)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional, enables source-map upload during docker build:
# SENTRY_ORG= SENTRY_PROJECT= SENTRY_AUTH_TOKEN=

# View analytics IP hashing
VIEW_IP_SALT=

# Submission emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# AI smart search — leave AI_SEARCH_PROVIDER=mock if no key is wired yet;
# everything degrades to keyword fallback with a visible notice.
AI_SEARCH_PROVIDER=gemini # gemini | openai | mock
AI_API_KEY=
GEMINI_API_KEY=
AI_EMBEDDING_MODEL=models/gemini-embedding-001
AI_BASE_URL=

# ── Local dry-run ─────────────────────────────────────────────────────────────
# Test the production stack against locally run stand-ins for the two external
# dependencies (see docs/deploy-docker.md "Local dry-run"): docker-run Postgres
# + MinIO attached to the stack network (qad-prod_default). Copy the example,
# then change exactly these:
#   DOMAIN=localhost
#   CF_DNS_API_TOKEN=                  (empty → self-signed pair stays; issue is attempted and retried)
#   HTTP_PORT=8080  HTTPS_PORT=8443    (avoids whatever owns the machine's 80/443)
#   DATABASE_URL=postgres://postgres:postgres@qad-db:5432/qad
#   BUILD_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5434/qad
#   NEXT_PUBLIC_SITE_URL=https://localhost
#   AUTH_URL=https://localhost
#   R2_ENDPOINT=http://qad-minio:9000
#   R2_FORCE_PATH_STYLE=1
#   R2_BUCKET=qad
#   R2_ACCESS_KEY_ID=minioadmin
#   R2_SECRET_ACCESS_KEY=minioadmin
#   R2_PUBLIC_URL=http://localhost:9010/qad
